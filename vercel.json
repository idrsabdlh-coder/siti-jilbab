{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/produk/:slug*", "destination": "/produk/detail.html" }
  ],
  "redirects": [
    { "source": "/(.*)", "destination": "/", "statusCode": 404 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
